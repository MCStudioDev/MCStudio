rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserCompanyId() {
      return isAuthenticated() ? userProfile().data.companyId : null;
    }

    function belongsToUserCompany() {
      return isAuthenticated() && resource.data.companyId == getUserCompanyId();
    }

    function creatingForUserCompany() {
      return isAuthenticated() && request.resource.data.companyId == getUserCompanyId();
    }

    function keepsCompanyId() {
      return request.resource.data.companyId == resource.data.companyId;
    }

    match /users/{userId} {
      allow read, create: if isSelf(userId);
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "companyId",
          "role",
          "permissions"
        ]);
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        companyId == getUserCompanyId()
      );
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /patients/{patientId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update: if belongsToUserCompany() && keepsCompanyId();
      allow delete: if belongsToUserCompany();
    }

    match /drivers/{driverId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update: if belongsToUserCompany() && keepsCompanyId();
      allow delete: if belongsToUserCompany();
    }

    match /trips/{tripId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update: if belongsToUserCompany() && keepsCompanyId();
      allow delete: if belongsToUserCompany();
    }

    match /vehicles/{vehicleId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update: if belongsToUserCompany() && keepsCompanyId();
      allow delete: if belongsToUserCompany();
    }

    match /facilities/{facilityId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update: if belongsToUserCompany() && keepsCompanyId();
      allow delete: if belongsToUserCompany();
    }

    match /activities/{activityId} {
      allow read: if belongsToUserCompany();
      allow create: if creatingForUserCompany();
      allow update, delete: if false;
    }

    match /test/{testId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
