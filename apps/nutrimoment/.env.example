# ============================================================
# Firebase Configuration (from Firebase Console -> Project Settings)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# ============================================================
# API Keys (Server Only - NOT prefixed with NEXT_PUBLIC)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Replicate is required for premium/admin recipe-image generation.
# Without REPLICATE_API_TOKEN, premium users fall through to "no exact photo".
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# Optional JSON blob of extra Replicate input overrides (e.g. output_format, aspect_ratio).
# REPLICATE_IMAGE_INPUT_JSON={"output_format":"jpg"}
# Optional per-user daily Replicate generation cap; defaults to 100.
# REPLICATE_DAILY_LIMIT_PER_USER=100
LOG_LEVEL=info

# ============================================================
# Firebase Admin (Server Only - required for catalog seeding)
# Export these values from a Firebase service account JSON.
# ============================================================
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional migration guard: keep the retired per-user recipe cache disabled
# while all recipe retrieval and publication use sharedRecipesV2.
DISABLE_USER_RECIPE_CACHE=true
