rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == "admin";
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function hasOnlyUserWritableProfileFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "role",
        "tier",
        "status",
        "features",
        "aiCreditsUsed",
        "aiCreditsLimit",
        "aiCreditsRemaining",
        "entitlement"
      ]);
    }

    function hasNoAccessProfileFields() {
      return !request.resource.data.keys().hasAny([
        "role",
        "tier",
        "status",
        "features",
        "aiCreditsUsed",
        "aiCreditsLimit",
        "aiCreditsRemaining",
        "entitlement"
      ]);
    }

    function scanBelongsToRequester() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    function scanCreateBelongsToRequester() {
      return isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    function scanUpdateKeepsRequesterOwner() {
      return scanBelongsToRequester()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // =====================================
    // USER PROFILES
    // =====================================
    match /users/{userId} {
      // Users can read/write their own profile, but never their access tier/role.
      allow read: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && hasNoAccessProfileFields();
      allow update: if isOwner(userId) && hasOnlyUserWritableProfileFields();
      allow delete: if isAdmin();
      
      // =====================================
      // SUBCOLLECTIONS (Inventory, Recipes)
      // =====================================
      // Enforce isolation so one user cannot see another's scanned fridge items
      match /inventory/{item} {
        allow read, write: if isOwnerOrAdmin(userId);
      }
      
      match /recipes/{recipe} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /pantry/{item} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /history/{historyId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /notifications/{notificationId} {
        allow read, create, update, delete: if isOwnerOrAdmin(userId);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /mealPlans/{mealPlanId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /plans/{planId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /offlineRecipeCache/{recipeId} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /profile/{document=**} {
        allow read, write: if isOwnerOrAdmin(userId);
      }

      match /usage/{usageId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if isAdmin();
      }
    }

    match /entitlements/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow write: if isAdmin();
    }

    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Read-only public catalog for offline retrieval engine
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredientAliases/{aliasId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredientRecipeIndex/{ingredient} {
      allow read: if true;
      allow write: if false;
    }

    match /sharedOfflineRecipeCache/{recipeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /recipePhotoCache/{photoId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /scans/{scanId} {
      allow read: if isAdmin() || scanBelongsToRequester();
      allow create: if scanCreateBelongsToRequester();
      allow update: if isAdmin() || scanUpdateKeepsRequesterOwner();
      allow delete: if isAdmin() || scanBelongsToRequester();
    }

    match /metrics/{document=**} {
      allow read, write: if isAdmin();
    }

    match /recipeSources/{sourceId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /recipeRawImports/{importId} {
      allow read, write: if false;
    }

    match /recipeCanonicalStaging/{stagingId} {
      allow read, write: if false;
    }

    match /debugSeedProbe/{probeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
