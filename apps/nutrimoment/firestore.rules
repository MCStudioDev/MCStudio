rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =====================================
    // USER PROFILES
    // =====================================
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isOwner(userId);
      
      // =====================================
      // SUBCOLLECTIONS (Inventory, Recipes)
      // =====================================
      // Enforce isolation so one user cannot see another's scanned fridge items
      match /inventory/{item} {
        allow read, write: if isOwner(userId);
      }
      
      match /recipes/{recipe} {
        allow read, write: if isOwner(userId);
      }

      match /pantry/{item} {
        allow read, write: if isOwner(userId);
      }

      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /mealPlans/{mealPlanId} {
        allow read, write: if isOwner(userId);
      }

      match /profile/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Read-only public catalog for offline retrieval engine
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredientAliases/{aliasId} {
      allow read: if true;
      allow write: if false;
    }

    match /ingredientRecipeIndex/{ingredient} {
      allow read: if true;
      allow write: if false;
    }

    match /scans/{scanId} {
      allow read, write: if isAuthenticated();
    }
  }
}
