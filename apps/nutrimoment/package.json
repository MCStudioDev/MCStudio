{
  "name": "nutrimoment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:prod-env": "tsx scripts/validate-production-env.ts",
    "catalog:v2:build": "tsx scripts/build-cuisine-catalog-v2.ts",
    "predeploy:check": "npm run lint && npm run build && npm run validate:prod-env",
    "test": "vitest run",
    "qa:matrix": "tsx scripts/run-qa-matrix.ts",
    "qa:launch-recipes": "tsx scripts/launch-recipe-audit.ts",
    "test:rules": "firebase emulators:exec --only firestore --project nutrimoment-rules-test \"vitest run\"",
    "seed:offline-catalog": "tsx scripts/seed-offline-catalog.ts",
    "backfill:bilingual-recipes": "tsx scripts/backfill-bilingual-recipes.ts",
    "backfill:shared-recipe-cache": "tsx scripts/backfill-shared-recipe-cache.ts",
    "delete:shared-recipe-pool": "tsx scripts/delete-shared-recipe-pool.ts",
    "cleanup:shared-recipe-cache-quality": "tsx scripts/cleanup-shared-recipe-cache-quality.ts",
    "clear:recipe-photo-cache": "tsx scripts/clear-recipe-photo-cache.ts",
    "categorize:recipe-photo-cache": "tsx scripts/categorize-recipe-photo-cache.ts",
    "dedupe:recipe-photo-cache-urls": "tsx scripts/dedupe-recipe-photo-cache-urls.ts",
    "backfill:transient-recipe-images": "tsx scripts/backfill-transient-recipe-images.ts",
    "normalize:cached-recipe-languages": "tsx scripts/normalize-cached-recipe-languages.ts",
    "prune:user-history": "tsx scripts/prune-user-history.ts",
    "cleanup:synthetic-recipes": "tsx scripts/cleanup-synthetic-recipes.ts",
    "import:real-recipes": "tsx scripts/import-real-recipes.ts",
    "import:recipenlg-reference": "tsx scripts/import-recipenlg-reference.ts",
    "set:user-access": "tsx scripts/set-user-access.ts",
    "inspect:user-recipes": "tsx scripts/inspect-user-recipes.ts"
